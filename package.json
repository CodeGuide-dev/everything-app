{
  "name": "@repo/monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "worker:dev": "turbo dev --filter=@repo/worker",
    "web:dev": "turbo dev --filter=@repo/web",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:pull": "turbo db:pull",
    "db:migrate": "turbo db:migrate",
    "db:studio": "turbo db:studio",
    "db:reset": "turbo db:reset",
    "db:up": "docker compose up postgres redis -d",
    "db:down": "docker compose down postgres redis",
    "db:dev": "docker compose --profile dev up postgres-dev -d",
    "db:dev-down": "docker compose --profile dev down postgres-dev",
    "docker:build": "docker build -t codeguide-starter-fullstack . && docker build -f Dockerfile.worker -t codeguide-starter-fullstack-worker .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "turbo": "^2.6.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}